/* ===================================================================
   FFmpeg Native Transcoder - 专业级暗黑主题样式表 (QSS)
   遵循 qt-component-design 规范：视觉样式与 C++ 代码逻辑彻底解耦
   =================================================================== */

/* 全局基底 */
QWidget {
    background-color: #14161d;
    color: #e2e8f0;
    font-family: "Segoe UI", "Microsoft YaHei UI", "PingFang SC", sans-serif;
    font-size: 13px;
    selection-background-color: #0ea5e9;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #14161d;
}

/* 顶部一体化命令导航栏 */
#topBarWidget {
    background-color: #1b1e27;
    border-bottom: 1px solid #2b3142;
    padding: 6px 12px;
}

#brandLogoLabel {
    font-size: 16px;
    font-weight: 800;
    color: #38bdf8;
    letter-spacing: 0.5px;
}

#brandVersionBadge {
    background-color: #0369a1;
    color: #e0f2fe;
    font-size: 10px;
    font-weight: bold;
    border-radius: 3px;
    padding: 2px 6px;
    margin-left: 4px;
}

#brandSloganLabel {
    font-size: 11px;
    color: #64748b;
    margin-left: 6px;
}

/* 核心操作按钮组 */
QPushButton {
    background-color: #222632;
    color: #e2e8f0;
    border: 1px solid #333a4c;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #2a3040;
    border-color: #475569;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #1a1d26;
}

QPushButton:disabled {
    background-color: #181a22;
    color: #475569;
    border-color: #232733;
}

#btnPrimary {
    background-color: #0284c7;
    color: #ffffff;
    border: 1px solid #0ea5e9;
}

#btnPrimary:hover {
    background-color: #0369a1;
    border-color: #38bdf8;
}

#btnSuccess {
    background-color: #059669;
    color: #ffffff;
    border: 1px solid #10b981;
}

#btnSuccess:hover {
    background-color: #047857;
    border-color: #34d399;
}

#btnWarning {
    background-color: #b45309;
    color: #ffffff;
    border: 1px solid #f59e0b;
}

#btnWarning:hover {
    background-color: #92400e;
    border-color: #fbbf24;
}

#btnDanger {
    background-color: #991b1b;
    color: #fecaca;
    border: 1px solid #dc2626;
}

#btnDanger:hover {
    background-color: #b91c1c;
    color: #ffffff;
}

/* 霓虹拖拽感应区 (DropAreaWidget) */
DropAreaWidget {
    background-color: #1a1d26;
    border: 2px dashed #333a4c;
    border-radius: 8px;
}

DropAreaWidget[isDragging="true"] {
    background-color: #0c4a6e;
    border: 2px dashed #38bdf8;
}

#dropIconLabel {
    font-size: 26px;
    background: transparent;
}

#dropTitleLabel {
    font-size: 13px;
    font-weight: 700;
    color: #f1f5f9;
    background: transparent;
}

#dropHintLabel {
    font-size: 11px;
    color: #64748b;
    background: transparent;
}

#dropBrowseBtn {
    background-color: #252a37;
    border: 1px solid #3b4256;
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 11px;
}

#dropBrowseBtn:hover {
    background-color: #2e3546;
}

/* 任务列表容器视图 (TaskListView) 与空状态灰色提示 */
TaskListView {
    background-color: #171922;
    border: 1px solid #272c3d;
    border-radius: 8px;
}

TaskListView[isDragging="true"] {
    border: 2px dashed #38bdf8;
    background-color: #162032;
}

#taskListScrollArea, #taskListContainer {
    background-color: transparent;
    border: none;
}

#taskEmptyPlaceholder {
    background-color: transparent;
}

#taskEmptyTitle {
    color: #94a3b8;
    font-size: 15px;
    font-weight: 600;
    background: transparent;
}

#taskEmptySubtitle {
    color: #64748b;
    font-size: 13px;
    background: transparent;
}

/* 任务列表项卡片 (TaskItemWidget) */
TaskItemWidget {
    background-color: #1b1e27;
    border: 1px solid #2b3142;
    border-radius: 8px;
}

TaskItemWidget:hover {
    background-color: #202430;
    border-color: #0ea5e9;
}

TaskItemWidget[state="Converting"] {
    border-left: 4px solid #0ea5e9;
    background-color: #18202f;
}

TaskItemWidget[state="Completed"] {
    border-left: 4px solid #10b981;
}

TaskItemWidget[state="Failed"] {
    border-left: 4px solid #ef4444;
}

TaskItemWidget[state="Paused"] {
    border-left: 4px solid #f59e0b;
}

#itemThumbLabel {
    background-color: #0e1015;
    border-radius: 5px;
    border: 1px solid #2b3142;
}

#itemTitleLabel {
    font-size: 13px;
    font-weight: 700;
    color: #f8fafc;
    background: transparent;
}

#itemDetailLabel {
    font-size: 11px;
    color: #94a3b8;
    background: transparent;
}

#itemMetricsLabel {
    font-size: 11px;
    color: #38bdf8;
    font-family: "Consolas", "Cascadia Code", monospace;
    font-weight: 600;
    background: transparent;
}

#itemActionBtn {
    background-color: #222632;
    border: 1px solid #333a4c;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

#itemActionBtn:hover {
    background-color: #2c3243;
}

/* 状态胶囊徽章 (Pill Badges) */
#statusBadge {
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
}

#statusBadge[status="pending"] {
    background-color: #222632;
    color: #94a3b8;
    border: 1px solid #333a4c;
}

#statusBadge[status="analyzing"] {
    background-color: #312e81;
    color: #c7d2fe;
    border: 1px solid #4338ca;
}

#statusBadge[status="converting"] {
    background-color: #0c4a6e;
    color: #7dd3fc;
    border: 1px solid #0284c7;
}

#statusBadge[status="paused"] {
    background-color: #451a03;
    color: #fde68a;
    border: 1px solid #b45309;
}

#statusBadge[status="completed"] {
    background-color: #064e3b;
    color: #6ee7b7;
    border: 1px solid #059669;
}

#statusBadge[status="failed"] {
    background-color: #450a0a;
    color: #fca5a5;
    border: 1px solid #dc2626;
}

#statusBadge[status="canceled"] {
    background-color: #222632;
    color: #64748b;
    border: 1px solid #333a4c;
}

/* 媒体分析与封面卡片 (MediaInfoCard) */
MediaInfoCard {
    background-color: #1b1e27;
    border: 1px solid #2b3142;
    border-radius: 8px;
}

#thumbLabel {
    background-color: #0e1015;
    border: 1px solid #262c3b;
    border-radius: 8px;
    color: #64748b;
}

#mediaTitleBox {
    background: transparent;
}

#fileNameLabel {
    font-size: 18px;
    font-weight: 700;
    color: #f8fafc;
    background: transparent;
}

#filePathLabel {
    font-size: 12px;
    color: #64748b;
    background: transparent;
}

#metaGridContainer {
    background-color: #161822;
    border: 1px solid #282e3e;
    border-radius: 8px;
}

#metaTitleLabel {
    color: #94a3b8;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}

#metaValueLabel {
    color: #38bdf8;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}

/* 选项卡控件 (QTabWidget) */
QTabWidget::pane {
    border: 1px solid #2b3142;
    background-color: #1b1e27;
    border-radius: 8px;
    margin-top: -1px;
}

QTabBar::tab {
    background-color: #161821;
    color: #94a3b8;
    border: 1px solid #2b3142;
    border-bottom: none;
    padding: 8px 16px;
    margin-right: 4px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: 600;
    font-size: 12px;
}

QTabBar::tab:hover {
    background-color: #222633;
    color: #f1f5f9;
}

QTabBar::tab:selected {
    background-color: #1b1e27;
    color: #38bdf8;
    border-top: 2px solid #0ea5e9;
    border-bottom: 1px solid #1b1e27;
}

/* 分组面板 (QGroupBox 卡片) */
QGroupBox {
    border: 1px solid #2b3142;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 12px;
    background-color: #1b1e27;
    font-weight: 600;
    color: #38bdf8;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    background-color: #1b1e27;
}

/* 下拉选择框 QComboBox */
QComboBox {
    background-color: #14161d;
    color: #f1f5f9;
    border: 1px solid #333a4c;
    border-radius: 5px;
    padding: 5px 10px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #0ea5e9;
}

QComboBox:focus {
    border-color: #38bdf8;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: #1b1e27;
    color: #f1f5f9;
    border: 1px solid #333a4c;
    selection-background-color: #0284c7;
    selection-color: #ffffff;
    padding: 4px;
}

/* 滑动条 QSlider */
QSlider::groove:horizontal {
    height: 4px;
    background: #333a4c;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #0ea5e9;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #0ea5e9;
    width: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #38bdf8;
}

/* 进度条 QProgressBar */
QProgressBar {
    background-color: #0f1117;
    border: 1px solid #2b3142;
    border-radius: 3px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #0ea5e9;
    border-radius: 2px;
}

/* 滚动条 QScrollBar */
QScrollBar:vertical {
    border: none;
    background: #14161d;
    width: 7px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #2d3345;
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #475569;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* 【等效 FFmpeg 核心参数实时预览终端卡片】 */
#commandPreviewCard {
    background-color: #0b0c10;
    border: 1px solid #1e2433;
    border-radius: 6px;
    padding: 6px 12px;
}

#commandPreviewText {
    background: transparent;
    color: #38bdf8;
    font-family: "Consolas", "Cascadia Code", "Fira Code", monospace;
    font-size: 13px;
    border: none;
    padding: 4px 6px;
}

/* 底部全局状态栏 */
QStatusBar {
    background-color: #101218;
    border-top: 1px solid #232734;
    color: #64748b;
    font-size: 12px;
}

#listEmptyLabel {
    color: #475569;
    font-size: 13px;
    padding: 50px 20px;
}

QSplitter::handle {
    background-color: #232734;
}

QSplitter::handle:hover {
    background-color: #0ea5e9;
}

/* ===================================================================
   多工作区侧边栏与页面架构样式扩展 (无外部项目引用)
   =================================================================== */

/* 顶部性能监视与系统条 */
#topInfoBar {
    background-color: #17181c;
    border-bottom: 1px solid #23242a;
}

#topAppIcon {
    font-size: 11px;
    font-weight: 800;
    color: #e2e8f0;
    background-color: #2b2d35;
    border-radius: 4px;
    padding: 3px 8px;
    letter-spacing: 0.5px;
}

#topPerfLabel {
    color: #8e94a5;
    font-family: "Consolas", "Cascadia Code", monospace;
    font-size: 12px;
}

#topStatusBadge {
    background-color: #163828;
    color: #4ade80;
    border: 1px solid #22c55e;
    font-size: 11px;
    font-weight: bold;
    border-radius: 4px;
    padding: 2px 8px;
}

/* 纵向导航侧边栏 */
#navSidebar {
    background-color: #17181c;
    border-right: 1px solid #23242a;
}

#navSearchEdit {
    background-color: #202228;
    border: 1px solid #2b2d36;
    border-radius: 6px;
    color: #e2e8f0;
    padding: 6px 10px;
    font-size: 12px;
}

#navSearchEdit:focus {
    border-color: #38bdf8;
}

#navSeparator {
    color: #262830;
    background-color: #262830;
    max-height: 1px;
}

#navItemBtn {
    background-color: transparent;
    color: #9499a8;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
}

#navItemBtn:hover {
    background-color: #22242c;
    color: #f1f5f9;
}

#navItemBtn[isActive="true"] {
    background-color: #313542;
    color: #ffffff;
    font-weight: bold;
    border-left: 3px solid #38bdf8;
}

/* 起始页面 / 仪表盘 */
#homeContainer {
    background-color: #121316;
}

#homeBannerCard {
    background-color: #1a1c22;
    border: 1px solid #262832;
    border-radius: 8px;
}

#homeBannerIcon {
    font-size: 12px;
    font-weight: 900;
    color: #f1f5f9;
    background-color: #3b3f4d;
    border-radius: 6px;
    padding: 8px 12px;
}

#homeBannerTitle {
    font-size: 18px;
    font-weight: 800;
    color: #f8fafc;
}

#homeBannerSubtitle {
    font-size: 12px;
    color: #64748b;
}

#homeCleanBtn {
    background-color: #272a33;
    color: #cbd5e1;
    border: 1px solid #363b47;
    border-radius: 6px;
    padding: 6px 14px;
}

#homeCleanBtn:hover {
    background-color: #323642;
    color: #ffffff;
}

#homeCard {
    background-color: #181a20;
    border: 1px solid #242630;
    border-radius: 8px;
}

#homeCardHeader {
    font-size: 14px;
    font-weight: 700;
    color: #38bdf8;
    border-bottom: 1px solid #242630;
    padding-bottom: 6px;
}

#homeCardItem {
    font-size: 12px;
    color: #94a3b8;
    line-height: 1.4;
}

#homeCardActionBtn {
    background-color: transparent;
    color: #0ea5e9;
    border: none;
    text-align: left;
    font-weight: bold;
    font-size: 12px;
    padding: 4px 0;
}

#homeCardActionBtn:hover {
    color: #38bdf8;
    text-decoration: underline;
}

/* 编码队列页面 */
#queueMenuBar {
    background-color: transparent;
    border-bottom: 1px solid #242630;
}

#queueMenuTitle {
    font-size: 14px;
    font-weight: 700;
    color: #38bdf8;
}

#btnActionStart { color: #22c55e; font-weight: bold; }
#btnActionStart:hover { color: #4ade80; text-decoration: underline; }

#btnActionPause { color: #eab308; font-weight: bold; }
#btnActionPause:hover { color: #fde047; text-decoration: underline; }

#btnActionResume { color: #06b6d4; font-weight: bold; }
#btnActionResume:hover { color: #22d3ee; text-decoration: underline; }

#btnActionStop { color: #ef4444; font-weight: bold; }
#btnActionStop:hover { color: #f87171; text-decoration: underline; }

#btnActionRemove { color: #f43f5e; font-weight: bold; }
#btnActionRemove:hover { color: #fb7185; text-decoration: underline; }

#btnActionReset { color: #f97316; font-weight: bold; }
#btnActionReset:hover { color: #fb923c; text-decoration: underline; }

#btnActionApplyAll { color: #38bdf8; font-weight: bold; }
#btnActionApplyAll:hover { color: #7dd3fc; text-decoration: underline; }

#btnActionLocate { color: #a855f7; font-weight: bold; }
#btnActionLocate:hover { color: #c084fc; text-decoration: underline; }

#statTotalLabel { color: #94a3b8; font-size: 12px; font-weight: bold; }
#statRunningLabel { color: #22c55e; font-size: 12px; font-weight: bold; }
#statErrorLabel { color: #ef4444; font-size: 12px; font-weight: bold; }

#queueTableHeader {
    background-color: #17181e;
    border-bottom: 1px solid #262832;
}

#queueHeaderCol {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
}

/* 准备文件页面 */
#btnPrimaryPrep {
    background-color: #0284c7;
    color: #ffffff;
    border: 1px solid #0ea5e9;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: bold;
}

#btnPrimaryPrep:hover {
    background-color: #0369a1;
}

#prepFileTable {
    background-color: #17181e;
    border: 1px solid #262832;
    border-radius: 6px;
    gridline-color: #242630;
    color: #e2e8f0;
}

#prepFileTable::item {
    padding: 6px 8px;
}

#prepFileTable::item:selected {
    background-color: #1e3a5f;
    color: #ffffff;
}

#prepBottomHint {
    font-size: 12px;
    color: #64748b;
    padding: 6px 4px;
}

/* 参数面板页面 */
#paramSubSidebar {
    background-color: #15161a;
    border-right: 1px solid #242630;
}

#paramSubSep {
    color: #242630;
    background-color: #242630;
    max-height: 1px;
}

#paramSubBtn {
    background-color: transparent;
    color: #9499a8;
    border: none;
    border-radius: 4px;
    padding: 6px 8px;
    text-align: left;
    font-size: 12px;
}

#paramSubBtn:hover {
    background-color: #20222a;
    color: #f1f5f9;
}

#paramSubBtn[active="true"] {
    background-color: #2f3442;
    color: #ffffff;
    font-weight: bold;
}

#paramSectionTitle {
    font-size: 14px;
    font-weight: 700;
    color: #f8fafc;
}

#paramSectionSubtitle {
    font-size: 11px;
    color: #64748b;
}

#paramTagBadge {
    background-color: #20222a;
    color: #38bdf8;
    font-family: "Consolas", "Cascadia Code", monospace;
    font-size: 11px;
    font-weight: bold;
    border: 1px solid #2c303c;
    border-radius: 4px;
    padding: 4px 6px;
}

#btnApplyToAllParams {
    background-color: #0284c7;
    border: 1px solid #0ea5e9;
    color: #ffffff;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

#btnApplyToAllParams:hover {
    background-color: #0369a1;
    border-color: #38bdf8;
    color: #ffffff;
}

#btnCopyCmd {
    background-color: #1e2433;
    border: 1px solid #333d54;
    color: #38bdf8;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

#btnCopyCmd:hover {
    background-color: #0284c7;
    border-color: #38bdf8;
    color: #ffffff;
}

#inspectorPageTitle {
    font-size: 16px;
    font-weight: 700;
    color: #38bdf8;
}

/* 媒体信息页 - 右侧队列视频列表面板 */
#inspectorRightPanel {
    background-color: #181b24;
    border: 1px solid #282e3e;
    border-radius: 8px;
}

#inspectorListHeader {
    font-size: 13px;
    font-weight: 700;
    color: #f1f5f9;
}

#inspectorListBadge {
    font-size: 11px;
    font-weight: 600;
    color: #38bdf8;
    background-color: #14161d;
    border: 1px solid #282e3e;
    border-radius: 10px;
    padding: 2px 8px;
}

#inspectorVideoList {
    background-color: #14161d;
    border: 1px solid #242834;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

#inspectorVideoList::item {
    background-color: #1a1e28;
    color: #e2e8f0;
    border: 1px solid #232836;
    border-radius: 6px;
    padding: 10px 12px;
    margin-bottom: 6px;
    font-size: 13px;
}

#inspectorVideoList::item:hover {
    background-color: #22293a;
    border-color: #38bdf8;
    color: #ffffff;
}

#inspectorVideoList::item:selected {
    background-color: #1e3a5f;
    border: 1px solid #38bdf8;
    color: #ffffff;
    font-weight: 600;
}

#inspectorEmptyLabel {
    color: #64748b;
    font-size: 12px;
    background-color: transparent;
    padding: 16px;
}

/* 实时双分屏画面对比检视页面 */
#liveMonitorPage {
    background-color: #14161d;
}

#liveMonitorTitle {
    font-size: 16px;
    font-weight: 700;
    color: #38bdf8;
}

#liveMonitorSubtitle {
    font-size: 12px;
    color: #94a3b8;
}

#liveHwBadge {
    background-color: #0f291e;
    color: #34d399;
    border: 1px solid #059669;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}

#btnCompareModeSide, #btnCompareModeCurtain, #btnCompareModeProcessed {
    background-color: #222632;
    color: #94a3b8;
    border: 1px solid #333a4c;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

#btnCompareModeSide:hover, #btnCompareModeCurtain:hover, #btnCompareModeProcessed:hover {
    background-color: #2a3040;
    border-color: #475569;
    color: #ffffff;
}

#btnCompareModeSide:checked, #btnCompareModeCurtain:checked, #btnCompareModeProcessed:checked {
    background-color: #0369a1;
    border: 1px solid #38bdf8;
    color: #ffffff;
}

#videoCompareWidget {
    background-color: #090a0f;
    border: 1px solid #232836;
    border-radius: 8px;
}

#liveFilterCard {
    background-color: #181b24;
    border: 1px solid #282e3e;
    border-radius: 8px;
}

#checkLiveDelogo {
    color: #e2e8f0;
    font-weight: 600;
    font-size: 12px;
}

#liveSpinLabel {
    color: #94a3b8;
    font-size: 12px;
}

#liveSpinBox {
    background-color: #14161d;
    border: 1px solid #333a4c;
    border-radius: 4px;
    color: #e2e8f0;
    padding: 2px 6px;
    min-width: 60px;
}

#liveSpinBox:focus {
    border-color: #38bdf8;
}

#liveHintLabel {
    color: #64748b;
    font-size: 11px;
}
