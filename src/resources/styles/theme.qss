/* ===================================================================
   FFmpeg Native Transcoder - 专业级暗黑主题样式表 (QSS)
   遵循 qt-component-design 规范：视觉样式与 C++ 代码逻辑彻底解耦
   =================================================================== */

/* 全局基底 */
QWidget {
    background-color: #14161d;
    color: #e2e8f0;
    font-family: "Segoe UI", "Microsoft YaHei UI", "PingFang SC", sans-serif;
    font-size: 13px;
    selection-background-color: #0ea5e9;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #14161d;
}

/* 顶部一体化命令导航栏 */
#topBarWidget {
    background-color: #1b1e27;
    border-bottom: 1px solid #2b3142;
    padding: 6px 12px;
}

#brandLogoLabel {
    font-size: 16px;
    font-weight: 800;
    color: #38bdf8;
    letter-spacing: 0.5px;
}

#brandVersionBadge {
    background-color: #0369a1;
    color: #e0f2fe;
    font-size: 10px;
    font-weight: bold;
    border-radius: 3px;
    padding: 2px 6px;
    margin-left: 4px;
}

#brandSloganLabel {
    font-size: 11px;
    color: #64748b;
    margin-left: 6px;
}

/* 核心操作按钮组 */
QPushButton {
    background-color: #222632;
    color: #e2e8f0;
    border: 1px solid #333a4c;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #2a3040;
    border-color: #475569;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #1a1d26;
}

QPushButton:disabled {
    background-color: #181a22;
    color: #475569;
    border-color: #232733;
}

#btnPrimary {
    background-color: #0284c7;
    color: #ffffff;
    border: 1px solid #0ea5e9;
}

#btnPrimary:hover {
    background-color: #0369a1;
    border-color: #38bdf8;
}

#btnSuccess {
    background-color: #059669;
    color: #ffffff;
    border: 1px solid #10b981;
}

#btnSuccess:hover {
    background-color: #047857;
    border-color: #34d399;
}

#btnWarning {
    background-color: #b45309;
    color: #ffffff;
    border: 1px solid #f59e0b;
}

#btnWarning:hover {
    background-color: #92400e;
    border-color: #fbbf24;
}

#btnDanger {
    background-color: #991b1b;
    color: #fecaca;
    border: 1px solid #dc2626;
}

#btnDanger:hover {
    background-color: #b91c1c;
    color: #ffffff;
}

/* 霓虹拖拽感应区 (DropAreaWidget) */
DropAreaWidget {
    background-color: #1a1d26;
    border: 2px dashed #333a4c;
    border-radius: 8px;
}

DropAreaWidget[isDragging="true"] {
    background-color: #0c4a6e;
    border: 2px dashed #38bdf8;
}

#dropIconLabel {
    font-size: 26px;
    background: transparent;
}

#dropTitleLabel {
    font-size: 13px;
    font-weight: 700;
    color: #f1f5f9;
    background: transparent;
}

#dropHintLabel {
    font-size: 11px;
    color: #64748b;
    background: transparent;
}

#dropBrowseBtn {
    background-color: #252a37;
    border: 1px solid #3b4256;
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 11px;
}

#dropBrowseBtn:hover {
    background-color: #2e3546;
}

/* 任务列表容器视图 (TaskListView) 与空状态灰色提示 */
TaskListView {
    background-color: #171922;
    border: 1px solid #272c3d;
    border-radius: 8px;
}

TaskListView[isDragging="true"] {
    border: 2px dashed #38bdf8;
    background-color: #162032;
}

#taskListScrollArea, #taskListContainer {
    background-color: transparent;
    border: none;
}

#taskEmptyPlaceholder {
    background-color: transparent;
}

#taskEmptyTitle {
    color: #94a3b8;
    font-size: 15px;
    font-weight: 600;
    background: transparent;
}

#taskEmptySubtitle {
    color: #64748b;
    font-size: 13px;
    background: transparent;
}

/* 任务列表项卡片 (TaskItemWidget) */
TaskItemWidget {
    background-color: #1b1e27;
    border: 1px solid #2b3142;
    border-radius: 8px;
}

TaskItemWidget:hover {
    background-color: #202430;
    border-color: #0ea5e9;
}

TaskItemWidget[state="Converting"] {
    border-left: 4px solid #0ea5e9;
    background-color: #18202f;
}

TaskItemWidget[state="Completed"] {
    border-left: 4px solid #10b981;
}

TaskItemWidget[state="Failed"] {
    border-left: 4px solid #ef4444;
}

TaskItemWidget[state="Paused"] {
    border-left: 4px solid #f59e0b;
}

#itemThumbLabel {
    background-color: #0e1015;
    border-radius: 5px;
    border: 1px solid #2b3142;
}

#itemTitleLabel {
    font-size: 13px;
    font-weight: 700;
    color: #f8fafc;
    background: transparent;
}

#itemDetailLabel {
    font-size: 11px;
    color: #94a3b8;
    background: transparent;
}

#itemMetricsLabel {
    font-size: 11px;
    color: #38bdf8;
    font-family: "Consolas", "Cascadia Code", monospace;
    font-weight: 600;
    background: transparent;
}

#itemActionBtn {
    background-color: #222632;
    border: 1px solid #333a4c;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

#itemActionBtn:hover {
    background-color: #2c3243;
}

/* 状态胶囊徽章 (Pill Badges) */
#statusBadge {
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
}

#statusBadge[status="pending"] {
    background-color: #222632;
    color: #94a3b8;
    border: 1px solid #333a4c;
}

#statusBadge[status="analyzing"] {
    background-color: #312e81;
    color: #c7d2fe;
    border: 1px solid #4338ca;
}

#statusBadge[status="converting"] {
    background-color: #0c4a6e;
    color: #7dd3fc;
    border: 1px solid #0284c7;
}

#statusBadge[status="paused"] {
    background-color: #451a03;
    color: #fde68a;
    border: 1px solid #b45309;
}

#statusBadge[status="completed"] {
    background-color: #064e3b;
    color: #6ee7b7;
    border: 1px solid #059669;
}

#statusBadge[status="failed"] {
    background-color: #450a0a;
    color: #fca5a5;
    border: 1px solid #dc2626;
}

#statusBadge[status="canceled"] {
    background-color: #222632;
    color: #64748b;
    border: 1px solid #333a4c;
}

/* 媒体分析与封面卡片 (MediaInfoCard) */
MediaInfoCard {
    background-color: #1b1e27;
    border: 1px solid #2b3142;
    border-radius: 8px;
}

#thumbLabel {
    background-color: #0e1015;
    border: 1px solid #262c3b;
    border-radius: 6px;
    color: #64748b;
}

#fileNameLabel {
    font-size: 14px;
    font-weight: 700;
    color: #f8fafc;
    background: transparent;
}

#filePathLabel {
    font-size: 11px;
    color: #64748b;
    background: transparent;
}

#metaTitleLabel {
    color: #94a3b8;
    font-size: 11px;
    background: transparent;
}

#metaValueLabel {
    color: #f1f5f9;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}

/* 选项卡控件 (QTabWidget) */
QTabWidget::pane {
    border: 1px solid #2b3142;
    background-color: #1b1e27;
    border-radius: 8px;
    margin-top: -1px;
}

QTabBar::tab {
    background-color: #161821;
    color: #94a3b8;
    border: 1px solid #2b3142;
    border-bottom: none;
    padding: 8px 16px;
    margin-right: 4px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: 600;
    font-size: 12px;
}

QTabBar::tab:hover {
    background-color: #222633;
    color: #f1f5f9;
}

QTabBar::tab:selected {
    background-color: #1b1e27;
    color: #38bdf8;
    border-top: 2px solid #0ea5e9;
    border-bottom: 1px solid #1b1e27;
}

/* 分组面板 (QGroupBox 卡片) */
QGroupBox {
    border: 1px solid #2b3142;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 12px;
    background-color: #1b1e27;
    font-weight: 600;
    color: #38bdf8;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    background-color: #1b1e27;
}

/* 下拉选择框 QComboBox */
QComboBox {
    background-color: #14161d;
    color: #f1f5f9;
    border: 1px solid #333a4c;
    border-radius: 5px;
    padding: 5px 10px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #0ea5e9;
}

QComboBox:focus {
    border-color: #38bdf8;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: #1b1e27;
    color: #f1f5f9;
    border: 1px solid #333a4c;
    selection-background-color: #0284c7;
    selection-color: #ffffff;
    padding: 4px;
}

/* 滑动条 QSlider */
QSlider::groove:horizontal {
    height: 4px;
    background: #333a4c;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #0ea5e9;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #0ea5e9;
    width: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #38bdf8;
}

/* 进度条 QProgressBar */
QProgressBar {
    background-color: #0f1117;
    border: 1px solid #2b3142;
    border-radius: 3px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #0ea5e9;
    border-radius: 2px;
}

/* 滚动条 QScrollBar */
QScrollBar:vertical {
    border: none;
    background: #14161d;
    width: 7px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #2d3345;
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #475569;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* 【等效 FFmpeg 核心参数实时预览终端卡片】 */
#commandPreviewCard {
    background-color: #0b0c10;
    border: 1px solid #1e2433;
    border-radius: 6px;
    padding: 8px 10px;
}

#cmdPreviewTitle {
    font-size: 11px;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 0.5px;
    background: transparent;
}

#commandPreviewText {
    background: transparent;
    color: #38bdf8;
    font-family: "Consolas", "Cascadia Code", "Fira Code", monospace;
    font-size: 12px;
    border: none;
}

/* 底部全局状态栏 */
QStatusBar {
    background-color: #101218;
    border-top: 1px solid #232734;
    color: #64748b;
    font-size: 12px;
}

#listEmptyLabel {
    color: #475569;
    font-size: 13px;
    padding: 50px 20px;
}

QSplitter::handle {
    background-color: #232734;
}

QSplitter::handle:hover {
    background-color: #0ea5e9;
}
